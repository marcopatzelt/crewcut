# Crewcut reads this file when the container starts. Never commit it; it is in .gitignore.

# Engine login. Usually empty: press "Connect Claude" in Crewcut once (the CLI's own sign-in, no terminal). On a server
# without a screen you can put a token from `claude setup-token` here instead (./start.sh asks for it there).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: rent GPUs at Vast.ai for 3D and long jobs. Without it, everything runs on this computer. See docs/compute.md.
VAST_API_KEY=

# Optional: thumbnails through the OpenAI image API (paid per image, always behind a card).
OPENAI_API_KEY=

# Optional: richer channel facts during onboarding (YouTube Data API key, read only).
YOUTUBE_API_KEY=

# Written by ./start.sh: this computer's address in your network, for the teleprompter QR code.
CREWCUT_LAN_HOST=
