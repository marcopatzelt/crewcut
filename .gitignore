# secrets
.env
*.key
*.pem
client_secret*.json
token*.json

# the user's studio folder (brand, episodes, state) never goes into the app repo
/studio/
/import/
/brand/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# node
node_modules/
web/dist/
web/.vite/

# media and renders
*.mp4
# the launch film (README and landing page); the master is a release asset, never in git
!docs/launch/*.mp4
# the landing page's meadow loops (hero and close), small web files
!site/media/meadow/*.mp4
*.mov
*.mkv
*.wav
*.m4a
*.mp3
!examples/demo/**/*.json
render-out/

# the demo renders into the studio copy; never into the repo
examples/demo/render/
examples/demo/export/
