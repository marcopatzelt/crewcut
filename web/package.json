{
  "name": "crewcut-web",
  "private": true,
  "version": "0.1.0",
  "description": "The Crewcut web app and the teleprompter page.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:words": "node scripts/check-words.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:materials": "node scripts/check-materials.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check": "node scripts/check-tokens.mjs && node scripts/check-forms.mjs && node scripts/check-words.mjs && node scripts/check-contrast.mjs && node scripts/check-fonts.mjs && node scripts/check-materials.mjs && node scripts/check-motion.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@astryxdesign/core": "0.7.4",
    "@stylexjs/stylex": "0.19.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
